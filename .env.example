# Required
OTTERWIKI_API_URL=http://otterwiki:80
OTTERWIKI_API_KEY=changeme
MCP_BASE_URL=https://your-mcp-host.example.com

# Optional — enables bearer token auth for Claude Code
MCP_AUTH_TOKEN=

# Optional — path to the robot.wtf platform SQLite DB. When set and readable,
# per-wiki MCP bearer tokens (wikis.mcp_token_hash) are accepted in addition
# to MCP_AUTH_TOKEN. Also read from ROBOT_DB_PATH if present.
# MCP_PLATFORM_DB=/srv/data/robot.db

# Optional — defaults to 8090
MCP_PORT=8090

# Optional for running outside Docker; Docker persists /app/data in mcp-data.
# MCP_OAUTH_DB=./mcp_oauth.db
